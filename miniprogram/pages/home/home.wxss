/* pages/home/home.wxss */

.home-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F9F0;
  overflow: hidden;
}

.home-scroll {
  flex: 1;
  height: 0;
}

/* ========== 顶部渐变横幅 ========== */
.hero-banner {
  position: relative;
  background: linear-gradient(145deg, #1E5C3A 0%, #2D7A4F 40%, #3D9E6A 100%);
  padding: 100rpx 40rpx 72rpx;
  overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
}

/* 装饰性半透明圆形 */
.hero-deco {
  position: absolute;
  border-radius: 50%;
  opacity: 0.08;
  background: #fff;
}

.hero-deco-1 {
  width: 320rpx;
  height: 320rpx;
  top: -80rpx;
  right: -60rpx;
}

.hero-deco-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: -40rpx;
  left: -40rpx;
}

.hero-deco-3 {
  width: 140rpx;
  height: 140rpx;
  top: 60rpx;
  left: 120rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(0,0,0,0.15));
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.hero-stats {
  margin-top: 28rpx;
}

.stat-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255,255,255,0.25);
  border-radius: 9999rpx;
  padding: 10rpx 28rpx;
}

.stat-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
}

/* ========== 功能入口 ========== */
.features-section {
  padding: 40rpx 32rpx 0;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E2B1E;
  margin-bottom: 24rpx;
  display: block;
  padding-left: 4rpx;
}

.feature-grid {
  display: flex !important;
  flex-wrap: wrap;
  padding-left: 8rpx;
  padding-right: 8rpx;
}

.feature-card {
  width: 50%;
  box-sizing: border-box;
  padding-left: 8rpx;
  padding-right: 8rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.feature-card-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 20rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(30, 43, 30, 0.07);
  transition: transform 150ms ease;
  position: relative;
  overflow: hidden;
  width: 85%;
}

/* 2x2布局无装饰条 */

.feature-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.feature-icon-bg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-bottom: 18rpx;
}

.feature-icon {
  font-size: 44rpx;
}

.feature-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E2B1E;
}

.feature-desc {
  display: none;
}

/* ========== 底部装饰 ========== */
.footer-deco {
  text-align: center;
  padding: 56rpx 0 32rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #5A6B5A;
  opacity: 0.5;
}

/* ========== 微交互 ========== */

/* 页面入场 */
.hero-banner {
  animation: heroFadeIn 600ms cubic-bezier(0.32,0.72,0,1) both;
}

@keyframes heroFadeIn {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.feature-card {
  animation: cardSlideUp 500ms cubic-bezier(0.32,0.72,0,1) both;
}
.feature-card:nth-child(1) { animation-delay: 100ms; }
.feature-card:nth-child(2) { animation-delay: 180ms; }
.feature-card:nth-child(3) { animation-delay: 260ms; }
.feature-card:nth-child(4) { animation-delay: 340ms; }

@keyframes cardSlideUp {
  from { opacity: 0; transform: translateY(32rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 统计数字跳动 */
.stat-number {
  animation: numberPop 600ms cubic-bezier(0.32,0.72,0,1) 400ms both;
}

@keyframes numberPop {
  0% { opacity: 0; transform: scale(0.5); }
  60% { transform: scale(1.15); }
  100% { opacity: 1; transform: scale(1); }
}

/* 卡片按压深度 */
.feature-card-inner:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(30,43,30,0.04);
}

/* ========== 可识别品种标签 ========== */
.species-section {
  padding-top: 32rpx;
  padding-bottom: 8rpx;
}

.species-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.species-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #D4E4D0;
  border-radius: 9999rpx;
  font-size: 24rpx;
  color: #2D7A4F;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(30,43,30,0.04);
  animation: tagPop 400ms cubic-bezier(0.32,0.72,0,1) both;
}

@keyframes tagPop {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}
