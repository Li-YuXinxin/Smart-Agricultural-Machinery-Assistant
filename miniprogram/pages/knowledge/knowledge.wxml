<!--pages/knowledge/knowledge.wxml-->
<view class="knowledge-page">
  <scroll-view scroll-y="true" enhanced="true" show-scrollbar="false" class="knowledge-scroll">
  <!-- 顶部渐变标题栏 -->
  <view class="knowledge-header">
    <view class="header-deco"></view>
    <text class="header-title">📖 养护笔记</text>
    <text class="header-sub">构建专属植物养护知识库</text>
  </view>

  <view class="knowledge-body page-padding">
    <!-- 上传区域 -->
    <view class="upload-card" bindtap="chooseFile" hover-class="upload-hover">
      <view class="upload-icon-ring">
        <text class="upload-icon">⬆️</text>
      </view>
      <view class="upload-text-area">
        <text class="upload-title">上传养护文档</text>
        <text class="upload-hint">支持 PDF / DOCX / TXT，单文件最大 10MB</text>
      </view>
      <text class="upload-arrow">›</text>
    </view>

    <!-- 上传结果 -->
    <view class="result-toast" wx:if="{{result}}">
      <text class="toast-icon">✅</text>
      <text class="toast-text">{{result.message}}</text>
    </view>

    <!-- 已上传文档列表 -->
    <view class="doc-section" wx:if="{{documents.length > 0}}">
      <view class="doc-section-header">
        <text class="doc-section-title">已上传文档</text>
        <view class="doc-count-pill">
          <text class="doc-count-num">{{documents.length}}</text>
        </view>
        <view class="doc-refresh-btn" bindtap="loadDocuments">
          <text class="refresh-text">刷新</text>
        </view>
      </view>
      <view class="doc-list">
        <view class="doc-item" wx:for="{{documents}}" wx:key="path" hover-class="doc-item-hover">
          <view class="doc-icon-bg" style="background: {{item.typeTag.bgColor}}">
            <text class="doc-type-icon">{{item.typeTag.icon}}</text>
          </view>
          <view class="doc-info">
            <text class="doc-name">{{item.displayName}}</text>
            <view class="doc-meta-row">
              <view class="doc-type-badge" style="background: {{item.typeTag.badgeBg}}; color: {{item.typeTag.badgeColor}}">
                <text class="badge-inner">{{item.typeTag.text}}</text>
              </view>
              <text class="doc-size">{{item.sizeText}}</text>
              <text class="doc-dot">·</text>
              <text class="doc-time">{{item.timeText}}</text>
            </view>
          </view>
          <view class="doc-actions">
            <text class="doc-preview" catchtap="previewDoc" data-doc="{{item}}">预览</text>
            <text class="doc-delete" catchtap="deleteDoc" data-doc="{{item}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{documents.length === 0}}" class="empty-state">
      <view class="empty-icon-bg">
        <text class="empty-emoji">📭</text>
      </view>
      <text class="empty-title">暂无已上传文档</text>
      <text class="empty-desc">上传养护文档，让 AI 顾问更懂你的植物</text>
    </view>
  </view>
  </scroll-view>
</view>
