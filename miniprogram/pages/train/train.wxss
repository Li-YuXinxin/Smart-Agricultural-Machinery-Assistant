/* pages/train/train.wxss */

/* 图片区域 */
.image-section {
  padding: 24rpx 32rpx;
}

.image-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* 图片网格：每行3张 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-item {
  position: relative;
  width: 190rpx;
  height: 190rpx;
}

.thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #f0f0f0;
}

/* 删除按钮 × */
.remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  border-radius: 50%;
}

/* 空状态提示 */
.empty-hint {
  text-align: center;
  padding: 48rpx 0;
  color: #bbb;
  font-size: 26rpx;
}

/* checkbox 行 */
.checkbox-row {
  padding: 20rpx 0;
}
