/* pages/train/train.wxss */

.train-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F9F0;
  overflow: hidden;
}

.train-scroll {
  flex: 1;
  overflow-y: auto;
}

/* ========== 顶部渐变标题 ========== */
.train-header {
  position: relative;
  background: linear-gradient(145deg, #1B5E3B, #2D7A4F, #4A9E6A);
  padding: 100rpx 40rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.header-deco {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  top: -80rpx;
  right: -60rpx;
}

.header-title {
  position: relative;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}

.header-sub {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 8rpx;
  display: block;
}

.train-body {
  padding-top: 32rpx;
  padding-bottom: 48rpx;
}

/* ========== 上传区域 ========== */
.upload-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.upload-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 110rpx;
  background: #FFFFFF;
  border: 3rpx dashed #D4E4D0;
  border-radius: 20rpx;
  transition: all 200ms ease;
}

.upload-btn-hover {
  border-color: #2D7A4F;
  background: #EDF5E8;
  transform: scale(0.98);
}

.upload-btn-icon-bg {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, rgba(45,122,79,0.1), rgba(61,158,106,0.15));
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn-icon {
  font-size: 28rpx;
}

.upload-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E2B1E;
}

.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 110rpx;
  background: #FFFFFF;
  border: 2rpx solid #D4E4D0;
  border-radius: 20rpx;
  transition: all 150ms ease;
}

.clear-btn-hover {
  background: rgba(229,57,53,0.06);
  border-color: #E53935;
}

.clear-btn-text {
  font-size: 26rpx;
  color: #E53935;
  font-weight: 500;
}

/* ========== 图片网格 ========== */
.image-section {
  margin-bottom: 28rpx;
}

.image-count-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.image-count {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E2B1E;
}

.count-pill {
  background: #2D7A4F;
  border-radius: 9999rpx;
  padding: 2rpx 14rpx;
}

.count-num {
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  position: relative;
  width: 190rpx;
  height: 190rpx;
}

.thumb {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background: #EDF5E8;
}

.remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: rgba(229,57,53,0.85);
  color: #fff;
  font-size: 28rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(229,57,53,0.3);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 48rpx;
}

.empty-icon-bg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(45,122,79,0.08), rgba(61,158,106,0.12));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.empty-emoji {
  font-size: 56rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E2B1E;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #5A6B5A;
}

/* ========== 输入卡片 ========== */
.input-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(30,43,30,0.05);
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E2B1E;
  display: block;
  margin-bottom: 12rpx;
}

.train-input {
  height: 76rpx;
  background: #F4F9F0;
  border: 2rpx solid #D4E4D0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1E2B1E;
}

/* ========== Checkbox 卡片 ========== */
.option-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(30,43,30,0.05);
  margin-bottom: 28rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkbox-text-area {
  flex: 1;
}

.checkbox-main {
  font-size: 28rpx;
  font-weight: 500;
  color: #1E2B1E;
  display: block;
}

.checkbox-sub {
  font-size: 22rpx;
  color: #5A6B5A;
  margin-top: 2rpx;
  display: block;
}

/* ========== 操作按钮 ========== */
.action-section {
  margin-bottom: 28rpx;
}

.primary-btn {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2D7A4F, #3D9E6A);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(45,122,79,0.3);
  transition: all 150ms ease;
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-disabled {
  background: #D4E4D0;
  box-shadow: none;
  opacity: 0.6;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

/* ========== 训练状态卡片 ========== */
.status-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(30,43,30,0.07);
}

.status-card-waiting {
  opacity: 0.6;
}

.status-header {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
  gap: 12rpx;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.status-running {
  background: #2D7A4F;
  box-shadow: 0 0 8rpx rgba(45,122,79,0.5);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.status-done {
  background: #4CAF50;
}

.status-failed {
  background: #E53935;
}

.status-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E2B1E;
  flex: 1;
}

.stop-btn {
  padding: 8rpx 20rpx;
  background: rgba(229,57,53,0.1);
  border-radius: 9999rpx;
}

.stop-btn-text {
  font-size: 22rpx;
  color: #E53935;
  font-weight: 600;
}

.status-body {
  padding: 20rpx 24rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-label {
  font-size: 24rpx;
  color: #5A6B5A;
}

.status-val {
  font-size: 26rpx;
  font-weight: 600;
}

.status-val-running { color: #2D7A4F; }
.status-val-done { color: #4CAF50; }
.status-val-failed { color: #E53935; }

.status-banner {
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.status-banner-success {
  background: #E8F5E9;
  color: #2E7D32;
}

.status-banner-error {
  background: #FFEBEE;
  color: #C62828;
}

.waiting-content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 12rpx;
}

.waiting-icon {
  font-size: 28rpx;
}

.waiting-text {
  font-size: 26rpx;
  color: #5A6B5A;
}

/* ========== 微交互 ========== */

.train-header {
  animation: headerSlideDown 500ms cubic-bezier(0.32,0.72,0,1) both;
}

@keyframes headerSlideDown {
  from { opacity: 0; transform: translateY(-16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.upload-btn {
  animation: cardFadeUp 500ms cubic-bezier(0.32,0.72,0,1) 100ms both;
}

@keyframes cardFadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.primary-btn:active {
  transform: scale(0.96);
}

.grid-item {
  animation: thumbPop 400ms cubic-bezier(0.32,0.72,0,1) both;
}

@keyframes thumbPop {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.status-card {
  animation: statusSlideUp 400ms cubic-bezier(0.32,0.72,0,1) both;
}

@keyframes statusSlideUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ========== 训练轮次进度条 ========== */
.epoch-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #E8F0E5;
}

.epoch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.epoch-label {
  font-size: 24rpx;
  color: #5A6B5A;
}

.epoch-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D7A4F;
  font-variant-numeric: tabular-nums;
}

.epoch-track {
  height: 16rpx;
  background: #EDF5E8;
  border-radius: 8rpx;
  overflow: hidden;
}

.epoch-fill {
  height: 100%;
  background: linear-gradient(90deg, #2D7A4F, #3D9E6A);
  border-radius: 8rpx;
  transition: width 500ms cubic-bezier(0.4,0,0.2,1);
  position: relative;
}

/* 进度条光效动画 */
.epoch-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  animation: progressShine 1.5s ease infinite;
}

@keyframes progressShine {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
