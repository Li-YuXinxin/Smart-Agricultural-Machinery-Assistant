/* pages/train/train.wxss */
.file-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #eee;
}
.thumb {
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.file-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.remove {
  color: #fa5151;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
}