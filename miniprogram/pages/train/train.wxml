<!--pages/train/train.wxml-->
<view class="container">
  <view>
    <!-- 文件上传按钮 -->
    <view>
      <button bindtap="chooseImages">选择图片</button>
      <button bindtap="clearImages">清除图片</button>
    </view>

    <!-- 文件列表 -->
    <view wx:if="{{imageList.length > 0}}">
      <view wx:for="{{imageList}}" wx:key="path">
        <text>{{index+1}}.{{item.name}}</text>
        <text bindtap="removeImage" data-index="{{index}}"></text>
      </view>
    </view>
    <view wx:else>
      暂未添加任何图片
    </view>

    <!-- 分类名称 -->
    <view>
      <text>分类名称：</text>
      <input placeholder="请输入分类名称" value="{{label}}" bindinput="onLabelInput" />
    </view>

    <!--  是否重新训练 -->
    <view>
      <checkbox checked="{{clearOld}}" bindchange="onClearOldChange" />
      <text>重新训练</text>
    </view>

    <!-- 操作按钮 -->
    <view>
      <button bindtap="startFull" disabled="{{!canStart || isTraining}}" loading="{{fullLoading}}">开始训练</button>
    </view>

    <!-- 微调状态 -->
    <view wx:if="{{status.status != 'idle'}}">
      <view>
        <text>训练状态:{{status.status}}</text>
        <button wx:if="{{status.status == 'running'}}" type="warn" size="mini" bindtap="stopTraining">停止训练</button>
      </view>
      <view wx:if="{{status.status==='done'}}">
        <text>训练成功</text>
      </view>
      <view wx:if="{{status.status==='failed'}}">
        <text>训练失败:{{status.result?status.result.error:'未知错误'}}</text>
      </view>
    </view>
    <view wx:else>
      <text>等待训练开始...</text>
    </view>
  </view>
</view>