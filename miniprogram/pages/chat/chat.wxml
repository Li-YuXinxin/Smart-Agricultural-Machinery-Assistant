<!--pages/chat/chat.wxml-->
<view class="chat-page">
  <!-- 顶部标题栏 -->
  <view class="chat-header">
    <view class="header-bg-deco"></view>
    <view class="header-content">
      <text class="chat-title">🌱 养护顾问</text>
      <text class="chat-subtitle">AI 智能解答</text>
    </view>
    <text class="chat-clear" bindtap="clearChat">清空</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="chat-body" scroll-y="true" scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <!-- 欢迎提示（无消息时） -->
    <view wx:if="{{messages.length === 0}}" class="welcome-hint">
      <view class="welcome-icon-bg">
        <text class="welcome-emoji">🌿</text>
      </view>
      <text class="welcome-text">你好，我是养护顾问</text>
      <text class="welcome-sub">输入你的植物养护问题，AI 将结合知识库为你解答</text>
      <!-- 常见问题快捷按钮 -->
      <view class="hot-questions">
        <view class="hot-q-item" wx:for="{{hotQuestions}}" wx:key="*this" bindtap="onHotQuestion" data-q="{{item}}">
          <text class="hot-q-icon">💡</text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="index" class="message-row {{item.role === 'user' ? 'message-user' : 'message-ai'}}" bindlongpress="onCopyMessage" data-content="{{item.content}}">
      <!-- 头像 -->
      <view class="avatar {{item.role === 'user' ? 'avatar-user' : 'avatar-ai'}}">
        <text>{{item.role === 'user' ? '我' : '🌿'}}</text>
      </view>
      <!-- 气泡 -->
      <view class="bubble-wrap">
        <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
          <!-- 用户消息：纯文本 -->
          <text wx:if="{{item.role === 'user'}}" class="bubble-text" user-select>{{item.content}}</text>
          <!-- AI消息：Markdown渲染 -->
          <view wx:if="{{item.role === 'ai'}}" class="bubble-text">
            <rich-text nodes="{{item.htmlContent}}" user-select class="{{isThinking && index === messages.length - 1 ? 'thinking-blink' : ''}}" style="display:inline"></rich-text>
          </view>
          <text wx:if="{{item.source}}" class="source-text source-link" bindtap="previewSource" data-source="{{item.source}}">📎 {{item.source}}</text>
        </view>
        <text class="msg-time">{{item.time}}</text>
      </view>
    </view>
    <view id="bottom"></view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view class="input-bar">
    <input class="chat-input" placeholder="输入你的养护问题..." value="{{inputText}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" />
    <view class="send-btn {{!inputText || isStreaming ? 'send-disabled' : ''}}" bindtap="sendMessage">
      <text>发送</text>
    </view>
  </view>
</view>
