          "selectedIconPath": "images/classify_active.png"
        },
        {
          "pagePath": "pages/train/train",
          "text": "模型训练",
          "iconPath": "images/train.png",
          "selectedIconPath": "images/train_active.png"
        },
        {
          "pagePath": "pages/home/home",
          "text": "首页",
          "iconPath": "images/home.png",
          "selectedIconPath": "images/home_active.png"
        },
        {
          "pagePath": "pages/knowledge/knowledge",
          "text": "知识库管理",
          "iconPath": "images/knowledge.png",
          "selectedIconPath": "images/knowledge_active.png"
        },
        {
          "pagePath": "pages/chat/chat",
