/**
 * 植物养护助手 — 工具类 Utilities
 * 基于 Design Tokens 的常用样式组合
 * 用法：在 app.wxss 中 @import './styles/utilities.wxss';
 */

/* ================================================================
   1. 卡片组件
   ================================================================ */

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(30,43,30,0.06);
}

.card-elevated {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30,43,30,0.08);
}

/* ================================================================
   2. 按钮组件
   ================================================================ */

/* 主按钮 */
.btn-primary {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: #2D7A4F;
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: opacity 150ms cubic-bezier(0.4,0,0.2,1);
}

.btn-primary:active {
  opacity: 0.85;
}

/* 强调按钮 */
.btn-accent {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: #D4943A;
  color: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  transition: opacity 150ms cubic-bezier(0.4,0,0.2,1);
}

.btn-accent:active {
  opacity: 0.85;
}

/* 幽灵按钮（描边） */
.btn-outline {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: transparent;
  color: #2D7A4F;
  border: 2rpx solid #2D7A4F;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: background 150ms cubic-bezier(0.4,0,0.2,1);
}

.btn-outline:active {
  background: rgba(45, 122, 79, 0.08);
}

/* 小按钮 */
.btn-sm {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

/* 禁用态 */
.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}


/* ================================================================
   3. 文字排版
   ================================================================ */

.text-heading {
  font-family: 'PingFang SC', sans-serif;
  font-weight: 700;
  color: #1E2B1E;
  line-height: 1.3;
}

.text-body {
  font-family: 'PingFang SC', sans-serif;
  font-weight: 400;
  color: #1E2B1E;
  line-height: 1.6;
}

.text-caption {
  font-size: 24rpx;
  color: #5A6B5A;
  line-height: 1.6;
}

.text-overline {
  font-size: 20rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  color: #2D7A4F;
}


/* ================================================================
   4. 表单元素
   ================================================================ */

.input-field {
  height: 72rpx;
  background: #EDF5E8;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1E2B1E;
}

.input-field-focus {
  border: 2rpx solid #2D7A4F;
  background: #FFFFFF;
}


/* ================================================================
   5. 布局工具
   ================================================================ */

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.gap-sm { gap: 8rpx; }
.gap-md { gap: 16rpx; }
.gap-lg { gap: 32rpx; }

/* 页面容器 */
.page-container {
  min-height: 100vh;
  background: #F4F9F0;
  box-sizing: border-box;
}

.page-padding {
  padding-left: 32rpx;
  padding-right: 32rpx;
}


/* ================================================================
   6. 分割线
   ================================================================ */

.divider {
  height: 2rpx;
  background: #E2EBDE;
  margin: 24rpx 0;
}


/* ================================================================
   7. 标签/徽章
   ================================================================ */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: #EDF5E8;
  color: #2D7A4F;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tag-accent {
  background: rgba(212, 148, 58, 0.12);
  color: #D4943A;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #E53935;
  color: #FFFFFF;
  border-radius: 9999rpx;
  font-size: 18rpx;
  font-weight: 600;
}


/* ================================================================
   8. 空状态
   ================================================================ */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 64rpx;
}

.empty-state-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-state-text {
  font-size: 28rpx;
  color: #5A6B5A;
  text-align: center;
  line-height: 1.8;
}


/* ================================================================
   9. 加载态
   ================================================================ */

.skeleton {
  background: linear-gradient(90deg,
    #EDF5E8 25%,
    #F4F9F0 37%,
    #EDF5E8 63%
  );
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 12rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}


/* ================================================================
   10. 头像
   ================================================================ */

.avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
}

.avatar-md {
  width: 72rpx;
  height: 72rpx;
  border-radius: 9999rpx;
}

.avatar-lg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
}
